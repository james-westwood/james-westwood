---
import '../styles/tokens.css'
import '../styles/carbon-intensity.css'
import ForecastWidget from '../components/ForecastWidget.astro'
const buildDate = new Date().toISOString()
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GB Carbon Intensity Forecast — james-westwood.dev</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js" defer></script>
    <meta name="description" content="A half-hourly probabilistic forecast of grid carbon intensity in Great Britain. P10 / P50 / P90 quantiles you can actually run a dishwasher against." />
  </head>
  <body data-accent="sdg-7">
    <!-- ============================================================
         HEADER
         ============================================================ -->
    <header class="site-header" id="siteHeader" data-screen-label="Header">
      <div class="container">
        <a class="wordmark" href="/" aria-label="james-westwood.dev home">
          jw<span class="dot">.</span><span class="tld">dev</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">home</a>
          <a href="/carbon-intensity" aria-current="page">projects</a>
          <a href="#">writing</a>
          <a href="#">about</a>
        </nav>
      </div>
    </header>

    <!-- ============================================================
         HERO + LIVE WIDGET
         ============================================================ -->
    <section class="hero" data-screen-label="01 Hero">
      <div class="container">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">james-westwood.dev</a>
          <span class="sep">/</span>
          <a href="/carbon-intensity">projects</a>
          <span class="sep">/</span>
          <span>gb-carbon-intensity</span>
        </nav>

        <div class="hero-row">
          <div>
            <h1>GB carbon intensity forecast</h1>
            <p class="lede">A half-hourly probabilistic forecast of grid carbon intensity in Great Britain. P10 / P50 / P90 quantiles you can actually run a dishwasher against.</p>
            <div class="sdg-badge" aria-label="UN Sustainable Development Goal 7">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
              SDG 7 — affordable and clean energy
            </div>
          </div>
          <div class="api-status" id="apiStatus" data-state="ok" role="status">
            <span class="dot" aria-hidden="true"></span>
            <span class="label">API live</span>
          </div>
        </div>

        <ForecastWidget />
      </div>
    </section>

    <!-- ============================================================
         HOW IT WORKS
         ============================================================ -->
    <section class="block" data-screen-label="02 How it works">
      <div class="container">
        <div class="eyebrow-row"><span class="eyebrow">02 · how it works</span></div>
        <h2>From the National Grid to your dishwasher</h2>
        <p class="section-sub">Five stages, retrained nightly. Each box is a small thing that does one job, and fails loudly when it can't.</p>

        <div class="arch">
          <div class="arch-flow">
            <div class="arch-node">
              <span class="num">01 · INGEST</span>
              <h4>Data</h4>
              <p>National Grid ESO API, half-hourly. Generation mix, demand, interconnector flow.</p>
              <div class="tags"><span class="tag">REST</span><span class="tag">5-min cron</span></div>
            </div>
            <div class="arch-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="arch-node">
              <span class="num">02 · FEATURES</span>
              <h4>Engineering</h4>
              <p>Lags, rolling means, day-of-week, ECMWF wind & temperature forecasts.</p>
              <div class="tags"><span class="tag">pandas</span><span class="tag">DuckDB</span></div>
            </div>
            <div class="arch-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="arch-node">
              <span class="num">03 · MODEL</span>
              <h4>Quantile regressor</h4>
              <p>LightGBM trained with pinball loss for P10, P50, P90. Retrained nightly.</p>
              <div class="tags"><span class="tag">LightGBM</span><span class="tag">MLflow</span></div>
            </div>
            <div class="arch-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="arch-node">
              <span class="num">04 · API</span>
              <h4>Forecast service</h4>
              <p>FastAPI on Cloud Run. Cached 30s. Returns JSON quantiles by horizon.</p>
              <div class="tags"><span class="tag">FastAPI</span><span class="tag">Cloud Run</span></div>
            </div>
            <div class="arch-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
            <div class="arch-node">
              <span class="num">05 · SURFACE</span>
              <h4>You</h4>
              <p>This widget, an iOS shortcut, and a Home Assistant integration. Open API.</p>
              <div class="tags"><span class="tag">Public</span><span class="tag">CC-BY 4.0</span></div>
            </div>
          </div>

          <dl class="arch-meta">
            <div><dt>Cadence</dt><dd>Retrain <span class="accent">nightly · 02:30 UTC</span></dd></div>
            <div><dt>Latency</dt><dd>p95 <span class="accent">182 ms</span> end-to-end</dd></div>
            <div><dt>Window</dt><dd>30-min × <span class="accent">up to 24 horizons</span></dd></div>
            <div><dt>Monitoring</dt><dd>Pinball loss, drift, freshness</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ============================================================
         EXPLAINABILITY (placeholder cards for task 9.7)
         ============================================================ -->
    <section class="block" data-screen-label="03 Explainability">
      <div class="container">
        <div class="eyebrow-row"><span class="eyebrow">03 · explainability</span></div>
        <h2>What's the model actually doing?</h2>
        <p class="section-sub">Three diagnostics I check when something looks off. Same Plotly figures used internally, embedded straight from the training notebook.</p>

        <div class="charts-grid">
          <article class="chart-card wide">
            <span class="ch-eyebrow">Fig. 1 · Feature importance (gain)</span>
            <h3>Lagged demand and wind dominate</h3>
            <p>Top 10 features by total gain across all three quantile boosters. <code>demand_lag_30m</code> and <code>wind_forecast_3h</code> together account for ~58% of split gain — unsurprising given GB's 30 GW of wind capacity.</p>
            <div id="plotImportance" class="plot" role="img" aria-label="Feature importance bar chart"></div>
          </article>

          <article class="chart-card b">
            <span class="ch-eyebrow">Fig. 2 · Calibration</span>
            <h3>Quantiles hold, just</h3>
            <p>Empirical coverage of the P10–P90 band over the last 90 days, by hour-of-day. Slight under-coverage between 17:00 and 20:00 — peak demand period, where the model is least confident.</p>
            <div id="plotCalibration" class="plot" role="img" aria-label="Calibration plot"></div>
          </article>

          <article class="chart-card c">
            <span class="ch-eyebrow">Fig. 3 · Residuals over horizon</span>
            <h3>Error grows non-linearly</h3>
            <p>Mean absolute pinball loss vs forecast horizon, last 30 days. Roughly flat to 4 hours, then climbs steeply — this is why the default horizon button is 4 hours.</p>
            <div id="plotResiduals" class="plot" role="img" aria-label="Residual error vs horizon"></div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         STACK + LINKS
         ============================================================ -->
    <section class="block" data-screen-label="04 Stack">
      <div class="container">
        <div class="eyebrow-row"><span class="eyebrow">04 · stack &amp; source</span></div>
        <h2>Built with boring, observable parts</h2>
        <p class="section-sub">No exotic dependencies. Everything here has been in production somewhere for at least five years. That's the point.</p>

        <div class="stack-grid">
          <div class="stack-col">
            <h4>Stack</h4>
            <div class="stack-tags">
              <span class="stack-tag"><span class="dot"></span>Python 3.12</span>
              <span class="stack-tag"><span class="dot"></span>LightGBM</span>
              <span class="stack-tag"><span class="dot"></span>scikit-learn</span>
              <span class="stack-tag"><span class="dot"></span>pandas</span>
              <span class="stack-tag"><span class="dot"></span>DuckDB</span>
              <span class="stack-tag"><span class="dot"></span>FastAPI</span>
              <span class="stack-tag"><span class="dot"></span>Pydantic</span>
              <span class="stack-tag"><span class="dot"></span>MLflow</span>
              <span class="stack-tag"><span class="dot"></span>Plotly</span>
              <span class="stack-tag"><span class="dot"></span>Docker</span>
              <span class="stack-tag"><span class="dot"></span>Cloud Run</span>
              <span class="stack-tag"><span class="dot"></span>Cloud Scheduler</span>
              <span class="stack-tag"><span class="dot"></span>BigQuery</span>
              <span class="stack-tag"><span class="dot"></span>GitHub Actions</span>
              <span class="stack-tag"><span class="dot"></span>Terraform</span>
            </div>
          </div>

          <div class="stack-col">
            <h4>Source &amp; data</h4>
            <div class="links-card">
              <a href="https://github.com/james-westwood/gb-carbon-intensity" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.94 10.94 0 0 1 5.74 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                <span class="label">github.com/james-westwood/gb-carbon-intensity<small>full source · MIT licence</small></span>
                <span class="ext">↗</span>
              </a>
              <a href="https://forecast-api-719697349745.europe-west1.run.app/docs" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6"/></svg>
                <span class="label">forecast-api-719697349745.europe-west1.run.app/docs<small>OpenAPI 3.1 · JSON · CC-BY 4.0</small></span>
                <span class="ext">↗</span>
              </a>
              <a href="https://api.carbonintensity.org.uk" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18M3 12h18"/></svg>
                <span class="label">National Grid ESO carbon intensity API<small>upstream data source</small></span>
                <span class="ext">↗</span>
              </a>
              <a href="https://github.com/james-westwood/gb-carbon-intensity/blob/main/notebooks/training.ipynb" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6l2 3h8v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg>
                <span class="label">Training notebook (renders on GitHub)<small>EDA, feature plots, calibration</small></span>
                <span class="ext">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FOOTER
         ============================================================ -->
    <footer class="site-footer" data-screen-label="Footer">
      <div class="container">
        <div class="footer-row">
          <div class="footer-col">
            <h5>jw.dev</h5>
            <p>Production ML for problems aligned with the UN Sustainable Development Goals. Independent, based in Bristol.</p>
          </div>
          <div class="footer-col">
            <h5>Site</h5>
            <a href="/">home</a>
            <a href="/carbon-intensity" aria-current="page">projects</a>
            <a href="#">writing</a>
            <a href="#">about</a>
          </div>
          <div class="footer-col">
            <h5>Elsewhere</h5>
            <a href="https://github.com/james-westwood" target="_blank" rel="noopener">github ↗</a>
            <a href="#" target="_blank" rel="noopener">linkedin ↗</a>
            <a href="#" target="_blank" rel="noopener">rss ↗</a>
            <a href="#" target="_blank" rel="noopener">email ↗</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 James Westwood · text CC-BY 4.0 · code MIT</span>
          <span>last deployed {new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })} · <span style="color:var(--accent)">●</span> all systems normal</span>
        </div>
      </div>
    </footer>

    <script>
      // Sticky header scroll handler (task 9.6)
      (function() {
        const header = document.getElementById('siteHeader')
        if (!header) return
        function onScroll() {
          header.setAttribute('data-scrolled', window.scrollY > 8 ? 'true' : 'false')
        }
        window.addEventListener('scroll', onScroll, { passive: true })
        onScroll()
      })()

      // Plotly explainability charts (task 9.7)
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof Plotly === 'undefined') return

        const bg = 'rgba(16,22,29,0)'
        const grid = '#1E2630'
        const axisColor = '#7D8B9B'
        const accent = '#FCC30B'
        const p10col = '#4FD1A1'
        const p90col = '#F47B60'

        // Fig 1: Feature importance (placeholder — replace with real SHAP values)
        const featImportance = {
          data: [{
            x: ['demand_lag_30m','wind_forecast_3h','temp_lag_30m','hour_sin','hour_cos','day_of_week','demand_rolling_3h','wind_lag_30m','interconnector','solar_forecast'],
            y: [0.32, 0.26, 0.14, 0.08, 0.06, 0.04, 0.03, 0.03, 0.02, 0.02],
            type: 'bar',
            marker: { color: accent, opacity: 0.85 },
            hovertemplate: '%{x}: %{y:.1%}<extra></extra>'
          }],
          layout: {
            paper_bgcolor: bg, plot_bgcolor: bg,
            font: { family: 'JetBrains Mono, monospace', size: 11, color: axisColor },
            xaxis: { tickangle: -45, gridcolor: grid, zeroline: false, tickfont: { size: 10 } },
            yaxis: { title: 'Gain', gridcolor: grid, zeroline: false, tickformat: '.0%' },
            margin: { l: 50, r: 20, t: 20, b: 100 },
            showlegend: false,
            height: 320
          },
          config: { displayModeBar: false, responsive: true }
        }
        Plotly.newPlot('plotImportance', featImportance.data, featImportance.layout, featImportance.config)

        // Fig 2: Calibration coverage (placeholder — replace with real empirical coverage)
        const hours = Array.from({length: 24}, (_, i) => i)
        const coverage = hours.map(h => {
          if (h >= 17 && h <= 20) return 0.88 + Math.random() * 0.04
          return 0.93 + Math.random() * 0.05
        })
        const calib = {
          data: [{
            x: hours,
            y: coverage,
            type: 'scatter',
            mode: 'lines+markers',
            line: { color: accent, width: 2 },
            marker: { size: 5, color: accent },
            hovertemplate: '%{x}:00 — %{y:.1%}<extra></extra>'
          }, {
            x: [0, 23], y: [0.9, 0.9],
            type: 'scatter',
            mode: 'lines',
            line: { color: p90col, width: 1, dash: 'dash' },
            name: 'target 90%',
            hovertemplate: 'Target: 90%<extra></extra>'
          }],
          layout: {
            paper_bgcolor: bg, plot_bgcolor: bg,
            font: { family: 'JetBrains Mono, monospace', size: 11, color: axisColor },
            xaxis: { title: 'Hour of day', gridcolor: grid, zeroline: false, tickfont: { size: 10 } },
            yaxis: { title: 'Empirical coverage', gridcolor: grid, zeroline: false, tickformat: '.0%', range: [0.85, 1] },
            margin: { l: 50, r: 20, t: 20, b: 50 },
            showlegend: false,
            height: 280
          },
          config: { displayModeBar: false, responsive: true }
        }
        Plotly.newPlot('plotCalibration', calib.data, calib.layout, calib.config)

        // Fig 3: Pinball loss vs horizon (placeholder — replace with real loss)
        const horizons = [1,2,3,4,6,8,12,16,20,24]
        const loss = [12, 13, 14, 15, 18, 22, 28, 38, 50, 65]
        const residuals = {
          data: [{
            x: horizons,
            y: loss,
            type: 'scatter',
            mode: 'lines+markers',
            line: { color: accent, width: 2 },
            marker: { size: 5, color: accent },
            hovertemplate: 'Horizon %{x}h: %{y} g/kWh<extra></extra>'
          }],
          layout: {
            paper_bgcolor: bg, plot_bgcolor: bg,
            font: { family: 'JetBrains Mono, monospace', size: 11, color: axisColor },
            xaxis: { title: 'Forecast horizon (periods)', gridcolor: grid, zeroline: false, tickfont: { size: 10 } },
            yaxis: { title: 'Mean pinball loss', gridcolor: grid, zeroline: false },
            margin: { l: 50, r: 20, t: 20, b: 50 },
            showlegend: false,
            height: 280
          },
          config: { displayModeBar: false, responsive: true }
        }
        Plotly.newPlot('plotResiduals', residuals.data, residuals.layout, residuals.config)
      })
    </script>
  </body>
</html>
