---
---

<div class="widget" data-screen-label="01a Live widget" id="forecastWidget">
  <div class="widget-toolbar">
    <span class="toolbar-label">forecast horizon:</span>
    <div class="horizon-group" role="group" aria-label="Forecast horizon">
      <button class="btn-horizon" data-h="2" aria-pressed="false" type="button">2 hrs</button>
      <button class="btn-horizon" data-h="4" aria-pressed="true" type="button">4 hrs</button>
      <button class="btn-horizon" data-h="8" aria-pressed="false" type="button">8 hrs</button>
      <button class="btn-horizon" data-h="12" aria-pressed="false" type="button">12 hrs</button>
    </div>
    <div class="widget-now">
      <span>last refreshed</span>
      <b id="lastRefreshed">—</b>
    </div>
  </div>

  <div class="q-row" id="qRow">
    <div class="q-card" data-q="p10">
      <div class="q-label">P10 — optimistic</div>
      <div class="q-value"><span data-val="p10">—</span><span class="unit">g/kWh</span></div>
      <div class="q-foot">next 30-min period</div>
    </div>
    <div class="q-card" data-q="p50">
      <div class="q-label">P50 — median</div>
      <div class="q-value"><span data-val="p50">—</span><span class="unit">g/kWh</span></div>
      <div class="q-foot">next 30-min period</div>
    </div>
    <div class="q-card" data-q="p90">
      <div class="q-label">P90 — pessimistic</div>
      <div class="q-value"><span data-val="p90">—</span><span class="unit">g/kWh</span></div>
      <div class="q-foot">next 30-min period</div>
    </div>
  </div>

  <div class="widget-chart">
    <div class="chart-head">
      <div class="chart-title">Quantile forecast — P10 / P50 / P90 uncertainty bands</div>
      <div class="chart-legend">
        <span><i class="swatch band"></i>P10–P90 band</span>
        <span><i class="swatch line"></i>P50 median</span>
        <span><i class="swatch dash-low"></i>P10 lower</span>
        <span><i class="swatch dash-high"></i>P90 upper</span>
      </div>
    </div>
    <svg class="chart-svg" id="forecastChart" viewBox="0 0 920 360" preserveAspectRatio="none" role="img" aria-label="Quantile carbon intensity forecast"></svg>
  </div>

  <div class="widget-foot">
    <div class="chip">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6 1.65 1.65 0 0 0 10 3.09V3a2 2 0 1 1 4 0v.09c0 .66.39 1.26 1 1.51a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82c.25.61.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09c-.66 0-1.26.39-1.51 1Z"/></svg>
      <span>LightGBM quantile regression</span>
    </div>
    <div class="chip">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="13" width="3" height="5"/><rect x="12" y="9" width="3" height="9"/><rect x="17" y="5" width="3" height="13"/></svg>
      <span>P10 / P50 / P90 outputs</span>
    </div>
    <div class="chip">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span>30-min settlement periods</span>
    </div>
    <div class="chip">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10Z"/></svg>
      <span>Deployed on Cloud Run</span>
    </div>
  </div>
</div>

<script>
  const API_BASE = 'https://forecast-api-719697349745.europe-west1.run.app';
  const CACHE_MS = 60000;
  const TIMEOUT_MS = 5000;

  const PAD = { l: 56, r: 24, t: 16, b: 36 };
  const W = 920, H = 360;

  const css = getComputedStyle(document.documentElement);
  const accent = css.getPropertyValue('--accent').trim() || '#FCC30B';
  const COL_LOW  = '#4FD1A1';
  const COL_HIGH = '#F47B60';
  const COL_MID  = accent;
  const BAND_FILL = 'rgba(244,123,96,0.16)';
  const GRID = css.getPropertyValue('--border-1').trim() || '#1E2630';
  const AXIS = css.getPropertyValue('--fg-3').trim() || '#7D8B9B';

  let activeHorizon = 4;
  let cache = { data: null, ts: 0, horizon: null };

  function smoothPath(points) {
    if (points.length < 2) return '';
    const p = points;
    let d = `M ${p[0][0]} ${p[0][1]}`;
    for (let i = 0; i < p.length - 1; i++) {
      const p0 = p[i - 1] || p[i];
      const p1 = p[i];
      const p2 = p[i + 1];
      const p3 = p[i + 2] || p2;
      const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
      const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
      const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
      const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
      d += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2[0]} ${p2[1]}`;
    }
    return d;
  }

  function setStatus(state) {
    const el = document.getElementById('apiStatus');
    if (!el) return;
    el.setAttribute('data-state', state);
    const label = el.querySelector('.label');
    if (label) {
      label.textContent = state === 'ok' ? 'API live' : state === 'error' ? 'API error' : 'loading...';
    }
  }

  function setSkeleton(on) {
    document.querySelectorAll('.q-card').forEach(c => {
      c.style.opacity = on ? '0.4' : '1';
      c.style.transition = 'opacity 200ms ease';
    });
    const chart = document.querySelector('.widget-chart');
    if (chart) {
      chart.style.opacity = on ? '0.4' : '1';
      chart.style.transition = 'opacity 200ms ease';
    }
  }

  function updateTimestamp() {
    const el = document.getElementById('lastRefreshed');
    if (!el) return;
    const now = new Date();
    const hh = now.getHours().toString().padStart(2, '0');
    const mm = now.getMinutes().toString().padStart(2, '0');
    const dd = now.getDate().toString().padStart(2, '0');
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const mon = months[now.getMonth()];
    const yyyy = now.getFullYear();
    el.textContent = `${hh}:${mm} BST · ${dd} ${mon} ${yyyy}`;
  }

  function renderChart(series) {
    const svg = document.getElementById('forecastChart');
    if (!svg) return;

    const { labels, p10, p50, p90 } = series;
    const n = labels.length;

    const allLow = Math.min(...p10);
    const allHigh = Math.max(...p90);
    const yMin = Math.floor((allLow - 4) / 5) * 5;
    const yMax = Math.ceil((allHigh + 4) / 5) * 5;

    const xAt = i => PAD.l + (i / (n - 1)) * (W - PAD.l - PAD.r);
    const yAt = v => PAD.t + (1 - (v - yMin) / (yMax - yMin)) * (H - PAD.t - PAD.b);

    const p10pts = p10.map((v, i) => [xAt(i), yAt(v)]);
    const p50pts = p50.map((v, i) => [xAt(i), yAt(v)]);
    const p90pts = p90.map((v, i) => [xAt(i), yAt(v)]);

    const yTicks = [];
    for (let v = yMin; v <= yMax; v += 5) yTicks.push(v);

    let out = '';

    yTicks.forEach((v, i) => {
      const y = yAt(v);
      out += `<line x1="${PAD.l}" x2="${W - PAD.r}" y1="${y}" y2="${y}" stroke="${GRID}" stroke-width="1" ${i % 2 ? 'opacity="0.55"' : ''}/>`;
    });

    yTicks.forEach(v => {
      const y = yAt(v);
      out += `<text x="${PAD.l - 10}" y="${y + 4}" text-anchor="end" font-family="JetBrains Mono, ui-monospace, monospace" font-size="12" fill="${AXIS}">${v} g</text>`;
    });

    labels.forEach((lab, i) => {
      out += `<text x="${xAt(i)}" y="${H - 10}" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="12" fill="${AXIS}">${lab}</text>`;
    });

    const bandBackPts = p10pts.slice().reverse();
    let bandD = smoothPath(p90pts);
    bandD += ` L ${p10pts[p10pts.length-1][0]} ${p10pts[p10pts.length-1][1]} `;
    const reverseSmooth = smoothPath(bandBackPts).replace(/^M [^ ]+ [^ ]+/, '');
    bandD += reverseSmooth + ' Z';

    out += `<path d="${bandD}" fill="${BAND_FILL}" stroke="none"/>`;

    out += `<path d="${smoothPath(p90pts)}" fill="none" stroke="${COL_HIGH}" stroke-width="2" stroke-dasharray="6 4" stroke-linecap="round"/>`;
    out += `<path d="${smoothPath(p10pts)}" fill="none" stroke="${COL_LOW}" stroke-width="2" stroke-dasharray="6 4" stroke-linecap="round"/>`;
    out += `<path d="${smoothPath(p50pts)}" fill="none" stroke="${COL_MID}" stroke-width="2.5" stroke-linecap="round"/>`;

    p90pts.forEach(([x, y]) => out += `<circle cx="${x}" cy="${y}" r="3.5" fill="${COL_HIGH}"/>`);
    p10pts.forEach(([x, y]) => out += `<circle cx="${x}" cy="${y}" r="3.5" fill="${COL_LOW}"/>`);
    p50pts.forEach(([x, y]) => out += `<circle cx="${x}" cy="${y}" r="4" fill="${COL_MID}"/>`);

    svg.innerHTML = out;

    const nextI = 0;
    const p10el = document.querySelector('[data-val="p10"]');
    const p50el = document.querySelector('[data-val="p50"]');
    const p90el = document.querySelector('[data-val="p90"]');
    if (p10el) p10el.textContent = p10[nextI];
    if (p50el) p50el.textContent = p50[nextI];
    if (p90el) p90el.textContent = p90[nextI];
  }

  async function fetchForecast(horizon) {
    const now = Date.now();
    if (cache.horizon === horizon && cache.data && (now - cache.ts) < CACHE_MS) {
      return cache.data;
    }

    setStatus('loading');
    setSkeleton(true);

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), TIMEOUT_MS);

    try {
      const resp = await fetch(`${API_BASE}/forecast?horizon=${horizon}`, {
        signal: controller.signal,
        headers: { 'Accept': 'application/json' }
      });
      clearTimeout(timeoutId);

      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

      const data = await resp.json();
      cache = { data, ts: now, horizon };
      return data;
    } catch (err) {
      clearTimeout(timeoutId);
      setStatus('error');
      setSkeleton(false);
      throw err;
    }
  }

  function formatTime(isoString) {
    const d = new Date(isoString);
    return d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
  }

  function transformData(apiData) {
    const points = apiData.points || [];
    const labels = points.map(p => formatTime(p.t));
    return {
      labels,
      p10: points.map(p => p.p10),
      p50: points.map(p => p.p50),
      p90: points.map(p => p.p90),
    };
  }

  async function loadAndRender(horizon) {
    try {
      const apiData = await fetchForecast(horizon);
      const series = transformData(apiData);
      renderChart(series);
      setStatus('ok');
      setSkeleton(false);
      updateTimestamp();
    } catch (err) {
      console.error('Forecast widget error:', err);
      setStatus('error');
      setSkeleton(false);
    }
  }

  loadAndRender(activeHorizon);

  document.querySelectorAll('.btn-horizon').forEach(btn => {
    btn.addEventListener('click', () => {
      const h = parseInt(btn.dataset.h, 10);
      if (h === activeHorizon) return;
      document.querySelectorAll('.btn-horizon').forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      activeHorizon = h;
      loadAndRender(h);
    });
  });
</script>
